{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alermol/bamhusk/releases/schema/manifest-1.json",
  "title": "Husk release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tool", "version", "source", "assets"],
  "properties": {
    "schema": {
      "const": 1
    },
    "tool": {
      "const": "husk"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["os", "arch", "url", "sha256", "size"],
        "properties": {
          "os": {
            "enum": ["linux", "macos", "windows"]
          },
          "arch": {
            "enum": ["x86_64", "aarch64", "universal2"]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
